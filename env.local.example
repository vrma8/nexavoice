# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Agora REST gateway region for the Conversational AI Engine: US (default) | EU | AP | CN.
# Must match the region your Agora project was created in (Agora Console → project →
# Configuration) — a mismatch makes the voice agent fail to start, i.e. the call "never
# connects", even though tokens work. India and the rest of Asia-Pacific: AP. Agora has no
# separate India gateway. An unrecognised value logs a warning and falls back to US.
# AGORA_AREA=US

# --- NexaVoice agent tools (voice) -------------------------------------------
# The Agora engine calls this app's /api/agent-tools/<tool> endpoints to read and
# (after customer confirmation) change demo orders. Both values are OPTIONAL:
#   • the public URL is taken from the request the agent invite arrives on (so a
#     Vercel or tunnel deployment configures itself), and
#   • the shared secret is derived from the App Certificate when unset.
# Set them explicitly to override — e.g. a fixed production URL, or a secret you
# want to be able to rotate independently of the certificate.
# AGENT_TOOLS_BASE_URL=https://your-deployment.example.com
# AGENT_TOOLS_SECRET=

# --- Database (PostgreSQL via Prisma) ------------------------------------------
# Conversation + case state, login identities (clients / support agents) and the
# demo shop all live in PostgreSQL, accessed through Prisma. Without DATABASE_URL
# the app runs in-memory only (fine for a quick look, but state is lost between
# requests — on Vercel every route is its own instance).
#
# 1. Point DATABASE_URL at a PostgreSQL database (Vercel: Storage → Create
#    Database → Postgres; Neon / Supabase / local Postgres all work).
# 2. Create the schema: `pnpm db:push` (or `pnpm db:migrate` for migrations).
#
# DATABASE_URL=postgresql://user:password@host:5432/nexavoice
#
# The support store is mirrored as one JSONB row in the StoreState table.
# NEXAVOICE_STATE_KEY=nexavoice      # row id, override to isolate a test store
# Force in-memory only (used by the contract checks): NEXAVOICE_STORE=memory

# Optional: fill an EMPTY store with a small demo fixture the first time any support
# route runs (one active chat, one escalated case waiting for a human, one resolved
# voice case) so /support-agent is not blank on a fresh deployment. Records have fixed
# ids, so simultaneous cold instances cannot double them, and nothing that already
# exists is ever overwritten. Same thing can be done by hand: `pnpm run seed`.
# NEXAVOICE_SEED=demo

# --- Agent language / voice ------------------------------------------------------
# Turn-detection (interaction) locale: en-IN (default) | hi-IN | bn-IN | ta-IN | te-IN | gu-IN | kn-IN | en-US
# AGENT_LANGUAGE=en-IN
# Deepgram STT language; "multi" (default) handles Hindi/English code-switching.
# AGENT_STT_LANGUAGE=multi
# MiniMax TTS voice id.
# AGENT_TTS_VOICE_ID=English_captivating_female1

# --- Optional BYOK LLM ------------------------------------------------------------
# OpenAI-compatible endpoint. Enables the LLM chat agent and routes the voice
# agent through /api/chat/completions (custom LLM with server-side tools).
# Without these the chat uses a built-in rule-based agent and the voice agent
# uses Agora-managed OpenAI.
# NEXT_LLM_URL=https://api.openai.com/v1/chat/completions
# NEXT_LLM_API_KEY=
# NEXT_LLM_MODEL=gpt-4o-mini
