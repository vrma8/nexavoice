generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id                String   @id @default(cuid())
  name              String
  email             String
  phone             String   @unique
  tier              String   @default("standard")
  city              String   @default("")
  address           String   @default("")
  preferredLanguage String   @default("english")
  walletBalanceInr  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cart               CartItem[]
  orders             Order[]
  walletTransactions WalletTransaction[]

  @@index([phone])
}

model WalletTransaction {
  id        String   @id @default(cuid())
  clientId  String
  amountInr Int
  label     String
  orderCode String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([createdAt])
}

model Agent {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  title     String   @default("Support Agent")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  title       String
  category    String
  description String   @default("")
  priceInr    Int
  emoji       String   @default("🛍️")
  imageUrl    String?
  rating      Float    @default(4.2)
  caution     String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([category])
}

model CartItem {
  id        String   @id @default(cuid())
  clientId  String
  productId String
  qty       Int      @default(1)
  addedAt   DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
  @@index([clientId])
}

model Order {
  id                 String    @id @default(cuid())
  code               String    @unique
  clientId           String
  status             String    @default("PLACED")
  totalInr           Int       @default(0)
  shippingAddress    String
  paymentMethod      String    @default("COD")
  placedAt           DateTime  @default(now())
  statusUpdatedAt    DateTime  @default(now())
  pausedSince        DateTime?
  expectedDelivery   DateTime
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  history            Json      @default("[]")
  updatedAt          DateTime  @updatedAt

  client Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items  OrderItem[]

  @@index([clientId])
  @@index([status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  sku       String
  title     String
  qty       Int
  priceInr  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([orderId])
}

model OrderCounter {
  id    String @id
  value Int    @default(10000)
}

model StoreState {
  id        String   @id
  rev       Int      @default(0)
  snapshot  Json
  updatedAt DateTime @updatedAt
}

