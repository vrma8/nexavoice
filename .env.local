# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=adf8f36b41bd4ab58ac564e8e0648ea9

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=d48dab5ec1184d14b343b2d4344573bc

# Optional: Custom LLM for chat mode (text chat interface)
# If not set, chat mode will use Agora's reseller OpenAI via /api/chat/completions
# NEXT_LLM_API_KEY=sk-...
# NEXT_LLM_URL=https://api.openai.com/v1/chat/completions

# Note: Voice mode (Agora ConvoAI) uses Agora reseller keys and does NOT require
# NEXT_LLM_API_KEY or any STT/TTS keys when using the default reseller pipeline.
AGORA_PROJECT_ID=A3yh0jIKP
AGORA_PROJECT_NAME=NexaVoice
AGORA_REGION=global
AGORA_APP_ID=adf8f36b41bd4ab58ac564e8e0648ea9
AGORA_ENABLED_FEATURES=rtc,rtm,convoai
AGORA_FEATURE_RTC=true
AGORA_FEATURE_RTM=true
AGORA_FEATURE_CONVOAI=true