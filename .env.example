# Application
PROJECT_NAME="NexaVoice - Multilingual Assistance-Line Agent"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL or SQLite)
DATABASE_URL=sqlite+aiosqlite:///./nexavoice.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/nexavoice

# Agora Real-Time Voice Configuration
AGORA_APP_ID=demo_agora_app_id
AGORA_APP_CERTIFICATE=demo_agora_app_certificate

# AI Model Provider APIs (Optional - intelligent local fallback enabled)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Telephony Provider (simulator | exotel | twilio | plivo | sip)
TELEPHONY_PROVIDER=simulator
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=
TELEPHONY_PHONE_NUMBER=+918000000000

# Confidence Thresholds
CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_MEDIUM_THRESHOLD=0.55
