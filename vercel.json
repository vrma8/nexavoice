{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --frozen-lockfile",
  "github": {
    "silent": true,
    "autoAlias": true
  },
  "regions": ["bom1"],
  "functions": {
    "app/api/invite-agent/route.ts": { "maxDuration": 30 },
    "app/api/health/route.ts": { "maxDuration": 30 },
    "app/api/agent-tools/[tool]/route.ts": { "maxDuration": 30 }
  }
}
